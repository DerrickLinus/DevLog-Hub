---
import BaseLayout from './BaseLayout.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { data } = post;
---

<BaseLayout title={data.title} description={data.description} type="article">
  <article>
    <header class="mb-8">
      <h1 class="text-3xl font-bold tracking-tight">{data.title}</h1>
      <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-neutral-500">
        <time datetime={data.date.toISOString()}>
          {data.date.toLocaleDateString('zh-CN', {
            year: 'numeric',
            month: 'long',
            day: 'numeric',
          })}
        </time>
        {data.updatedAt && (
          <span>更新于 {data.updatedAt.toLocaleDateString('zh-CN')}</span>
        )}
        <span class="rounded bg-neutral-100 px-1.5 py-0.5 text-xs dark:bg-neutral-800">
          {data.type}
        </span>
      </div>
    </header>

    <div class="prose prose-neutral max-w-none dark:prose-invert">
      <slot />
    </div>

    {data.tags.length > 0 && (
      <footer
        class="mt-10 flex flex-wrap gap-2 border-t border-neutral-200 pt-6 dark:border-neutral-800"
      >
        {data.tags.map((tag) => (
          <a
            href={`/blog/tag/${encodeURIComponent(tag)}/`}
            class="rounded-full bg-neutral-100 px-3 py-1 text-sm text-neutral-600 hover:text-neutral-900 dark:bg-neutral-800 dark:text-neutral-400 dark:hover:text-neutral-100"
          >
            #{tag}
          </a>
        ))}
      </footer>
    )}
  </article>
</BaseLayout>
