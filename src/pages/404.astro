---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="页面未找到">
  <div class="py-20 text-center">
    <h1 class="text-5xl font-bold">404</h1>
    <p class="mt-4 text-neutral-600 dark:text-neutral-400">页面不存在或已被移动。</p>
    <a href="/" class="mt-6 inline-block text-sm underline underline-offset-4">返回首页</a>
  </div>
</BaseLayout>
