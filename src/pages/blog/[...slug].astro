---
import { getCollection, render } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import { getAllSeries } from '../../utils/series';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

// 若文章属于某个系列，找到该系列信息传给布局渲染文内导航
const seriesInfo = post.data.series
  ? (await getAllSeries()).find(
      (s) => s.entry.id.replace(/\.(json|ya?ml)$/, '') === post.data.series,
    )
  : undefined;
---

<PostLayout post={post} headings={headings} series={seriesInfo}>
  <Content />
</PostLayout>
