const fallback = {
  icon: 'M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm1 15h-2v-2h2v2Zm0-4h-2V7h2v6Z',
  badge: 'bg-neutral-500 text-white',
};

function styleFor(label: string) {
  return platformStyles[label] ?? fallback;
}
---

<div class="flex flex-wrap items-center gap-2">
  {profile.social.map((s) => {
    const { icon, badge } = styleFor(s.label);
    return s.plain ? (
      <span
        title={s.label}
        class="inline-flex items-center gap-2 rounded-full border border-neutral-200 bg-neutral-50 py-1 pl-1 pr-3 text-[13px] dark:border-neutral-800 dark:bg-neutral-900"
      >
        <span class:list={['inline-flex h-6 w-6 items-center justify-center rounded-full', badge]}>
          <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor">
            <path d={icon} />
          </svg>
        </span>
        <span class="select-all font-medium text-neutral-800 dark:text-neutral-200">{s.url}</span>
      </span>
    ) : (
      <a
        href={s.url}
        title={s.label}
        class="inline-flex items-center gap-2 rounded-full border border-neutral-200 bg-neutral-50 py-1 pl-1 pr-3 text-[13px] transition-colors hover:border-neutral-300 hover:bg-neutral-100 dark:border-neutral-800 dark:bg-neutral-900 dark:hover:border-neutral-700 dark:hover:bg-neutral-800"
      >
        <span class:list={['inline-flex h-6 w-6 items-center justify-center rounded-full', badge]}>
          <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor">
            <path d={icon} />
          </svg>
        </span>
        <span class="font-medium text-neutral-800 dark:text-neutral-200">
          {s.label === 'GitHub' ? s.url.split('/').pop() : s.url.replace(/^https?:\/\//, '')}
        </span>
      </a>
    );
  })}
</div>
