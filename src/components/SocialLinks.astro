    icon: 'M8.69 3.5c-3.9 0-7.07 2.4-7.07 5.36 0 1.73 1.06 3.27 2.69 4.26l-.67 2.01 2.34-1.18c.53.13 1.09.2 1.66.22a5.6 5.6 0 0 1-.14-1.23c0-3.06 3.02-5.54 6.74-5.54.22 0 .44.01.66.03C14.2 5.4 11.7 3.5 8.69 3.5Zm-2.6 3.1a.94.94 0 1 1 0 1.88.94.94 0 0 1 0-1.88Zm5.21 0a.94.94 0 1 1 0 1.88.94.94 0 0 1 0-1.88Zm2.47 3.32c-3.28 0-5.94 2.05-5.94 4.58 0 2.52 2.66 4.57 5.94 4.57.47 0 .93-.05 1.38-.14l2.02 1.02-.58-1.73c1.4-.83 2.16-2.15 2.16-3.72 0-2.53-2.66-4.58-5.98-4.58Zm-2.15 2.66a.81.81 0 1 1 0 1.62.81.81 0 0 1 0-1.62Zm4.3 0a.81.81 0 1 1 0 1.62.81.81 0 0 1 0-1.62Z',
    badge: 'bg-emerald-500 text-white',
  },
  微信: {
    icon: 'M8.69 3.5c-3.9 0-7.07 2.4-7.07 5.36 0 1.73 1.06 3.27 2.69 4.26l-.67 2.01 2.34-1.18c.53.13 1.09.2 1.66.22a5.6 5.6 0 0 1-.14-1.23c0-3.06 3.02-5.54 6.74-5.54.22 0 .44.01.66.03C14.2 5.4 11.7 3.5 8.69 3.5Zm-2.6 3.1a.94.94 0 1 1 0 1.88.94.94 0 0 1 0-1.88Zm5.21 0a.94.94 0 1 1 0 1.88.94.94 0 0 1 0-1.88Zm2.47 3.32c-3.28 0-5.94 2.05-5.94 4.58 0 2.52 2.66 4.57 5.94 4.57.47 0 .93-.05 1.38-.14l2.02 1.02-.58-1.73c1.4-.83 2.16-2.15 2.16-3.72 0-2.53-2.66-4.58-5.98-4.58Zm-2.15 2.66a.81.81 0 1 1 0 1.62.81.81 0 0 1 0-1.62Zm4.3 0a.81.81 0 1 1 0 1.62.81.81 0 0 1 0-1.62Z',
