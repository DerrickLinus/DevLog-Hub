---
import type { SeriesInfo } from '../utils/series';
import { seriesSlug } from '../utils/series';
import StatusBadge from './SeriesStatusBadge.astro';

interface Props {
  series: SeriesInfo;
  /** 当前文章 slug，用于高亮当前章节 */
  currentSlug: string;
}

const { series, currentSlug } = Astro.props;
const idx = series.posts.findIndex((p) => p.slug === currentSlug);
const prev = idx > 0 ? series.posts[idx - 1] : undefined;
const next = idx >= 0 && idx < series.posts.length - 1 ? series.posts[idx + 1] : undefined;
---

<section class="mb-8 rounded-xl border border-neutral-200 bg-neutral-50 p-4 sm:p-5 dark:border-neutral-800 dark:bg-neutral-900/60">
  <div class="flex flex-wrap items-center justify-between gap-2">
    <a href={`/series/${seriesSlug(series.entry)}/`} class="font-medium hover:underline">
      📚 {series.entry.data.title}
    </a>
    <StatusBadge status={series.entry.data.status} />
  </div>

  {idx >= 0 && (
    <p class="mt-1 text-xs text-neutral-500 dark:text-neutral-400">
      本文是系列第 {idx + 1} 篇，共 {series.posts.length} 篇
    </p>
  )}

  <details class="mt-3 group">
    <summary class="cursor-pointer select-none text-sm text-neutral-600 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100">
      查看系列目录（{series.posts.length} 篇）
    </summary>
    <ol class="mt-3 space-y-1 border-l border-neutral-200 dark:border-neutral-700">
      {series.posts.map((p, i) => (
        <li>
          <a
            href={`/blog/${p.slug}/`}
            class:list={[
              'block py-1 pl-3 text-sm leading-snug',
              p.slug === currentSlug
                ? 'font-semibold text-neutral-900 dark:text-neutral-100'
                : 'text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100',
            ]}
          >
            {i + 1}. {p.data.title}
          </a>
        </li>
      ))}
    </ol>
  </details>
</section>

{(prev || next) && (
  <nav
    aria-label="系列内导航"
    class="mt-10 grid gap-3 border-t border-neutral-200 pt-6 dark:border-neutral-800 sm:grid-cols-2"
  >
    {prev ? (
      <a
        href={`/blog/${prev.slug}/`}
        class="group rounded-lg border border-neutral-200 p-3 transition-colors hover:border-neutral-400 dark:border-neutral-800 dark:hover:border-neutral-500"
      >
        <span class="text-xs text-neutral-400">← 上一篇（系列）</span>
        <span class="mt-1 block text-sm font-medium group-hover:underline">
          {prev.data.title}
        </span>
      </a>
    ) : (
      <span />
    )}
    {next && (
      <a
        href={`/blog/${next.slug}/`}
        class="group rounded-lg border border-neutral-200 p-3 text-right transition-colors hover:border-neutral-400 dark:border-neutral-800 dark:hover:border-neutral-500"
      >
        <span class="text-xs text-neutral-400">下一篇（系列）→</span>
        <span class="mt-1 block text-sm font-medium group-hover:underline">
          {next.data.title}
        </span>
      </a>
    )}
  </nav>
)}
