---
import type { CollectionEntry } from 'astro:content';

interface Props {
  resource: CollectionEntry<'resources'>;
}

const { resource } = Astro.props;
const { data } = resource;

// 用域名生成外部链接的 favicon 图标地址（无需本地图标资源）
const favicon = `https://www.google.com/s2/favicons?domain=${new URL(data.url).hostname}&sz=64`;
---

<a
  href={data.url}
  target="_blank"
  rel="noopener noreferrer"
  class="group flex gap-3 rounded-xl border border-neutral-200 p-4 transition-all hover:border-neutral-300 hover:shadow-md dark:border-neutral-800 dark:hover:border-neutral-700"
>
  <img
    src={favicon}
    alt=""
    width="24"
    height="24"
    loading="lazy"
    class="mt-0.5 h-6 w-6 shrink-0 rounded"
  />
  <div class="min-w-0">
    <div class="flex items-center gap-2">
      <span class="truncate font-medium text-neutral-900 group-hover:underline dark:text-neutral-100">
        {data.title}
      </span>
      <span class="shrink-0 rounded-full bg-neutral-100 px-2 py-0.5 text-xs text-neutral-600 dark:bg-neutral-800 dark:text-neutral-400">
        {data.category}
      </span>
    </div>
    <p
      class="mt-1 line-clamp-2 min-h-[2.5rem] text-sm text-neutral-600 dark:text-neutral-400"
    >
      {data.description}
    </p>
  </div>
</a>
