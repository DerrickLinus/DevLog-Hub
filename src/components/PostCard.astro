---
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { data } = post;
---

<article class="border-b border-neutral-200 py-6 last:border-0 dark:border-neutral-800">
  <div class="flex items-center gap-2 text-sm text-neutral-500">
    <time datetime={data.date.toISOString()}>
      {data.date.toLocaleDateString('zh-CN', {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
      })}
    </time>
    {data.type !== 'article' && (
      <span class="rounded bg-neutral-100 px-1.5 py-0.5 text-xs dark:bg-neutral-800">
        {data.type}
      </span>
    )}
  </div>
  <h2 class="mt-1 text-lg font-semibold">
    <a href={`/blog/${post.slug}/`} class="hover:underline">{data.title}</a>
  </h2>
  <p class="mt-1 text-neutral-600 dark:text-neutral-400">{data.description}</p>
  {data.tags.length > 0 && (
    <div class="mt-2 flex flex-wrap gap-2">
      {data.tags.map((tag) => (
        <a
          href={`/blog/tag/${encodeURIComponent(tag)}/`}
          class="text-xs text-neutral-500 hover:text-neutral-900 dark:hover:text-neutral-100"
        >
          #{tag}
        </a>
      ))}
    </div>
  )}
</article>
