---
interface Props {
  /** 当前激活的 tab：all | article | note | tags | archive */
  active: 'all' | 'article' | 'note' | 'tags' | 'archive';
}

const { active } = Astro.props;

const tabs = [
  { key: 'all', label: '全部', href: '/blog/' },
  { key: 'article', label: '技术文章', href: '/blog/type/article/' },
  { key: 'note', label: '系列笔记', href: '/blog/type/note/' },
  { key: 'tags', label: '标签', href: '/blog/tags/' },
  { key: 'archive', label: '归档', href: '/blog/archive/' },
] as const;
---

<div class="mb-8 flex flex-wrap items-center gap-1 border-b border-neutral-200 dark:border-neutral-800">
  {tabs.map((t) => (
    <a
      href={t.href}
      class:list={[
        '-mb-px border-b-2 px-3 py-2 text-sm transition-colors',
        active === t.key
          ? 'border-neutral-900 font-medium text-neutral-900 dark:border-neutral-100 dark:text-neutral-100'
          : 'border-transparent text-neutral-500 hover:text-neutral-900 dark:text-neutral-400 dark:hover:text-neutral-100',
      ]}
    >
      {t.label}
    </a>
  ))}
</div>
