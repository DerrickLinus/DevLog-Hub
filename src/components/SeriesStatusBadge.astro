---
interface Props {
  status: 'ongoing' | 'completed';
}

const { status } = Astro.props;
const map = {
  ongoing: {
    label: '连载中',
    class: 'bg-amber-100 text-amber-700 dark:bg-amber-500/15 dark:text-amber-400',
  },
  completed: {
    label: '已完结',
    class: 'bg-emerald-100 text-emerald-700 dark:bg-emerald-500/15 dark:text-emerald-400',
  },
} as const;
---

<span class:list={['rounded-full px-2 py-0.5 text-xs font-medium', map[status].class]}>
  {map[status].label}
</span>
